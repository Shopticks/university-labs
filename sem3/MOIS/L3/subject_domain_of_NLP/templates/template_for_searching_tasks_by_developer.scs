@search_tasks_by_developer_template = {
    rrel_init_template: {
        rrel_template: [*
            @input_param1 = (.._developer <-_ concept_company);;
            nrel_developer _-> (.._library _-> .._developer);;
            @output_param1 = (.._library <-_ concept_nlp_library);;
        *];
        rrel_template_input_params: {
             @input_param1
        };
        rrel_template_output_params: { 
            @output_param1
        }
    } (* <- nrel_search_set_template;; *);
    rrel_next_template: {
        rrel_init_template: {
            rrel_template: [*
                @input_param1 = (.._library <-_ concept_nlp_library);;
                rrel_library _-> (.._model _-> .._library);;
                @output_param1 = (.._model <-_ concept_nlp_model);;
            *];
            rrel_template_input_params: { @input_param1 };
            rrel_template_output_params: { @output_param1 }
        } (* <- nrel_search_set_template;; *);
        rrel_next_template: {
            rrel_init_template: {
                rrel_template: [*
                    @input_param1 = (.._model <-_ concept_nlp_model);;
                    rrel_model _-> (.._task _-> .._model);;
                    @output_param1 = (.._task <-_ concept_nlp_task);;
                *];
                rrel_template_input_params: {
                     @input_param1
                };
                rrel_template_output_params: { 
                    @output_param1
                }
            } (* <- nrel_search_set_template;; *)
        } (* <- nrel_fixed_search_strategy_template;; *)
    } (* <- nrel_fixed_search_strategy_template;; *)
};;

@search_tasks_by_developer_template
<- nrel_fixed_search_strategy_template;
=> nrel_main_idtf:
    [Шаблон поиска задач по разработчику]
    (* 
        <- lang_ru;; 
    *);;
