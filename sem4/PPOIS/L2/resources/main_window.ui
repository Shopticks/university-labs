  <property name="windowTitle">
   <string>Ветеринарный журнал</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ── Глобальный шрифт и цвет текста ──────────────────────── */
* {
    font-family: &quot;Inter&quot;;
	/* sans-serif*/
    font-size: 13px;
    color: #40513B;
}

/* ── Фон окна и всех QWidget ──────────────────────────────── */
QMainWindow, QWidget {
    background-color: #EDF1D6;
}

/* ── MenuBar ──────────────────────────────────────────────── */
QMenuBar {
    background-color: #40513B;
    color: #fcfcfc;
    padding: 2px 4px;
    spacing: 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    border-radius: 4px;
    color: #fcfcfc;
}
QMenuBar::item:selected {
    background-color: #609966;
}

/* ── Выпадающие меню ──────────────────────────────────────── */
QMenu {
    background-color: #EDF1D6;
    border: 1px solid #9DC08B;
    border-radius: 6px;
    padding: 4px 0;
}
QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
    margin: 1px 4px;
    color: #40513B;
}
QMenu::item:selected {
    background-color: #9DC08B;
    color: #40513B;
}
QMenu::separator {
    height: 1px;
    background: #9DC08B;
    margin: 4px 8px;
}

/* ── ToolBar ──────────────────────────────────────────────── */
QToolBar {
    background-color: #40513B;
    border: none;
    padding: 4px 6px;
    spacing: 4px;
}
QToolBar::separator {
    width: 1px;
    background: #609966;
    margin: 4px 4px;
}
QToolButton {
    background-color: transparent;
    color: #fcfcfc;
    border: none;
    border-radius: 5px;
    padding: 5px 10px;
    min-width: 32px;
    min-height: 32px;
}
QToolButton:hover   { background-color: #609966; }
QToolButton:pressed { background-color: #40513B; border: 1px solid #9DC08B; }
QToolButton:checked { background-color: #609966; border: 1px solid #9DC08B; }

/* ── Sidebar ──────────────────────────────────────────────── */
QFrame#sidebar {
    background-color: #40513B;
    border-right: 2px solid #609966;
}

/* Логотип в сайдбаре */
QLabel#logoLabel {
    color: #fcfcee;
    font-size: 18px;
    font-weight: bold;
    background-color: #40513B;
}

/* Разделители в сайдбаре */
QFrame#sidebarDivider,
QFrame#sidebarDivider2,
QFrame#sidebarDivider3 {
    background-color: #548046;
    border: none;
}

/* ВСЕ кнопки внутри sidebar — без повторений на каждой кнопке */
QFrame#sidebar QPushButton {
    background-color: transparent;
    color: #fcfcee;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 9px 14px;
    font-size: 13px;
    margin: 4px 2px 8px;
}
QFrame#sidebar QPushButton:hover   { background-color: #6DA65B; }
QFrame#sidebar QPushButton:pressed { background-color: #EDF1D6; color: #40513B; }
QFrame#sidebar QPushButton:checked { background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #F8FCE0,      /* Начало &quot;границы&quot; */
        stop: 0.05 #F8FCE0,   /* Конец &quot;границы&quot; (3% ширины) */
        stop: 0.05 #6DA65B,   /* Резкий переход в основной цвет */
        stop: 1 #6DA65B       /* Основной цвет до конца кнопки */
    ); 
	font-weight: bold;
}

/* Метка имени файла */
QLabel#configNameLabel {
    color: #9DC08B;
    font-size: 11px;
    padding: 4px 6px 0 6px;
    background-color: #40513B;
}

/* ── QTableView ───────────────────────────────────────────── */
QTableView#recordTable {
    background-color: #F8FCE0;
    alternate-background-color: #F8FCE0;
    gridline-color: #C8D8B0;
    border: none;
    selection-background-color: #F8FCE0;
    selection-color: #40513B;
}
QTableView#recordTable::item {
    padding: 6px 10px;
    border-bottom: 1px solid #E0EAC8;
}
QTableView#recordTable::item:selected {
    background-color: #9DC08B;
    color: #40513B;
}

/* Заголовки таблицы и дерева */
QHeaderView::section {
    background-color: #40513B;
    color: #EDF1D6;
    padding: 8px 10px;
    font-weight: bold;
    border: none;
    border-right: 1px solid #609966;
}
QHeaderView::section:hover { background-color: #609966; }

/* ── QTreeWidget ──────────────────────────────────────────── */
QTreeWidget#recordTree {
    background-color: #F8FCE0;
    alternate-background-color: #F8FCE0;
    border: none;
    selection-background-color: #9DC08B;
    selection-color: #40513B;
}
QTreeWidget#recordTree::item {
    padding: 4px 6px;
    border-bottom: 1px solid #E0EAC8;
}
QTreeWidget#recordTree::item:selected { background-color: #9DC08B; color: #40513B; }
QTreeWidget#recordTree::branch { background: transparent; color: #40513B; }
QTreeWidget#recordTree::branch:has-children:!has-siblings:closed,
QTreeWidget#recordTree::branch:closed:has-children:has-siblings {
    image: url(:/resources/images/arrow_right.svg);
}
QTreeWidget#recordTree::branch:open:has-children:!has-siblings,
QTreeWidget#recordTree::branch:open:has-children:has-siblings {
    image: url(:/resources/images/arrow_down.svg);
}

/* ── Pagination Bar ───────────────────────────────────────── */
QFrame#paginationBar {
    background-color: #AAC78F;
    border-top: 1px solid #609966;
}

/* Кнопки внутри paginationBar */
QFrame#paginationBar QPushButton {
    background-color: #6DA65B;
    color: #fcfcee;
    border: none;
    border-radius: 4px;
    min-width: 28px; max-width: 28px;
    min-height: 26px; max-height: 26px;
    font-size: 14px;
    font-weight: bold;
    padding: 0;
}
QFrame#paginationBar QPushButton:hover     { background-color: #40513B; }
QFrame#paginationBar QPushButton:disabled  { background-color: #C8D8B0; color: #9DC08B; }

/* Метки внутри paginationBar */
QFrame#paginationBar QLabel {
    color: #40513B;
    font-size: 12px;
    padding: 0 4px;
    background-color: transparent;
}
QLabel#totalRecordsLabel { color: #5A6B52; }

/* Тонкие вертикальные разделители-группы внутри paginationBar */
QFrame#paginationSeparator1, QFrame#paginationSeparator2 {
    color: #7FA374;
    background-color: #7FA374;
}

/* SpinBox внутри paginationBar */

QFrame#paginationBar QSpinBox {
    background-color: #F8FCE0;
    border: 1px solid #609966;
    border-radius: 4px;
    padding: 2px 4px;
    color: #40513B;
    min-height: 24px; max-height: 24px;
    font-size: 12px;
}
QFrame#paginationBar QSpinBox::up-button,
QFrame#paginationBar QSpinBox::down-button {
    width: 16px;
    background: #609966;
}

/* ── Поля ввода ───────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #9DC08B;
    border-radius: 5px;
    padding: 6px 8px;
    color: #40513B;
    selection-background-color: #9DC08B;
}
QLineEdit:focus, QTextEdit:focus { border: 1.5px solid #609966; background-color: #F8FAF0; }
QLineEdit:disabled               { background-color: #F0F3E4; color: #9DC08B; }

/* ── DateEdit ─────────────────────────────────────────────── */
QDateEdit, QDateTimeEdit {
    background-color: #ffffff;
    border: 1px solid #9DC08B;
    border-radius: 5px;
    padding: 5px 8px;
    color: #40513B;
    min-height: 28px;
}
QDateEdit:focus, QDateTimeEdit:focus { border: 1.5px solid #609966; }
QDateEdit::drop-down, QDateTimeEdit::drop-down { border: none; width: 20px; }

QCalendarWidget { background-color: #EDF1D6; border: 1px solid #9DC08B; border-radius: 6px; }
QCalendarWidget QToolButton { background-color: #40513B; color: #EDF1D6; border-radius: 4px; padding: 4px; }
QCalendarWidget QAbstractItemView { background-color: #ffffff; selection-background-color: #9DC08B; selection-color: #40513B; }

/* ── SpinBox ──────────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #9DC08B;
    border-radius: 5px;
    padding: 5px 8px;
    color: #40513B;
    min-height: 28px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border: 1.5px solid #609966; }

QFrame#paginationBar QSpinBox::up-arrow {
    image: url(:/resources/images/up_arrow.svg);
    width: 8px;
    height: 5px;
}

QFrame#paginationBar QSpinBox::down-arrow {
    image: url(:/resources/images/down_arrow.svg);
    width: 8px;
    height: 5px;
}

/* ── ComboBox ─────────────────────────────────────────────── */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #9DC08B;
    border-radius: 5px;
    padding: 5px 10px;
    color: #40513B;
    min-height: 28px;
}
QComboBox:focus            { border: 1.5px solid #609966; }
QComboBox::drop-down       { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #EDF1D6;
    border: 1px solid #9DC08B;
    selection-background-color: #9DC08B;
    selection-color: #40513B;
}

/* ── CheckBox ─────────────────────────────────────────────── */
QCheckBox { color: #40513B; spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1.5px solid #609966;
    border-radius: 3px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked { background-color: #609966; border-color: #609966; }
QCheckBox::indicator:hover   { border-color: #40513B; }

/* ── Скроллбары ───────────────────────────────────────────── */
QScrollBar:vertical   { background: #EDF1D6; width: 8px;  border-radius: 4px; margin: 0; }
QScrollBar:horizontal { background: #EDF1D6; height: 8px; border-radius: 4px; margin: 0; }
QScrollBar::handle:vertical   { background: #9DC08B; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:horizontal { background: #9DC08B; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover { background: #609966; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { height: 0; width: 0; background: none; }

/* ── StatusBar ────────────────────────────────────────────── */
QStatusBar {
    background-color: #40513B;
    color: #9DC08B;
    font-size: 11px;
    padding: 2px 8px;
}
QStatusBar::item { border: none; }

/* ── ToolTip ──────────────────────────────────────────────── */
QToolTip {
    background-color: #40513B;
    color: #EDF1D6;
    border: 1px solid #609966;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── GroupBox (для диалогов) ──────────────────────────────── */
QGroupBox {
    border: 1.5px solid #9DC08B;
    border-radius: 6px;
    margin-top: 14px;
    padding: 8px 6px 6px 6px;
    color: #609966;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #609966;
    font-weight: bold;
}
   
/* --- TableView --- */
QTableWidget {
	background-color: #EDF1D6;
}

QMessageBox {
    background-color: #EDF1D6;
    border: 1px solid #9DC08B;
    border-radius: 8px;
}

QMessageBox QLabel {
    color: #40513B;
    font-size: 13px;
    background-color: transparent;
}

QMessageBox QPushButton {
    background-color: #609966;
    color: #fcfcee;
    border: none;
    border-radius: 5px;
    padding: 6px 20px;
    font-size: 13px;
    min-width: 72px;
    min-height: 28px;
}

QMessageBox QPushButton:hover {
    background-color: #40513B;
}

QMessageBox QPushButton:pressed {
    background-color: #2e3d2a;
    border: 1px solid #9DC08B;
}

QMessageBox QPushButton:default {
    border: 2px solid #40513B;
}</string>
