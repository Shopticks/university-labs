  <property name="styleSheet">
   <string notr="true">/* ── Базовые стили ──────────────────────────────────────── */
* {
    font-family: &quot;Inter&quot;;
    font-size: 13px;
    color: #40513B;
}

QDialog, QWidget {
    background-color: #EDF1D6;
}

/* ── Заголовок диалога ──────────────────────────────────── */
QLabel#lblTitle {
    font-size: 17px;
    font-weight: bold;
    color: #40513B;
    padding-bottom: 4px;
}

/* ── Подписи секций ─────────────────────────────────────── */
QLabel#lblFormSection,
QLabel#lblResultsSection {
    font-size: 11px;
    font-weight: bold;
    color: #609966;
    padding-top: 4px;
}

/* ── Горизонтальные разделители (только наши, не трогаем календарь) */
QFrame#divider1,
QFrame#divider2,
QFrame#dividerResults {
    background-color: #C8D8B0;
    max-height: 1px;
    border: none;
    margin: 2px 0;
}

/* ── Выпадающий календарь ───────────────────────────────── */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #40513B;
    padding: 4px 8px;
}

QCalendarWidget QToolButton {
    color: #fcfcee;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 13px;
    font-weight: bold;
    min-width: 0;
}
QCalendarWidget QToolButton:hover {
    background-color: #609966;
}
QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

/* Year spinbox внутри календаря — как spinbox в главном окне */
QCalendarWidget QSpinBox {
    background-color: #F8FCE0;
    border: 1px solid #9DC08B;
    border-radius: 4px;
    padding: 3px 28px 3px 8px;
    color: #40513B;
    font-size: 13px;
    min-width: 64px;
    selection-background-color: #9DC08B;
    selection-color: #40513B;
}
QCalendarWidget QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #9DC08B;
    border-bottom: 1px solid #9DC08B;
    border-top-right-radius: 4px;
    background-color: #609966;
}
QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    border-left: 1px solid #9DC08B;
    border-top: 1px solid #9DC08B;
    border-bottom-right-radius: 4px;
    background-color: #609966;
}
QCalendarWidget QSpinBox::up-button:hover,
QCalendarWidget QSpinBox::down-button:hover {
    background-color: #6DA65B;
}
QCalendarWidget QSpinBox::up-arrow {
    image: url(:/resources/images/up_arrow.svg);
    width: 8px;
    height: 5px;
}
QCalendarWidget QSpinBox::down-arrow {
    image: url(:/resources/images/down_arrow.svg);
    width: 8px;
    height: 5px;
}

/* Сетка дней */
QCalendarWidget QAbstractItemView {
    background-color: #F8FCE0;
    alternate-background-color: #F5F8EC;
    selection-background-color: #609966;
    selection-color: #fcfcee;
    outline: none;
}
QCalendarWidget QAbstractItemView:enabled {
    color: #40513B;
}
QCalendarWidget QAbstractItemView:disabled {
    color: #C8D8B0;
}

/* ── Поля ввода ─────────────────────────────────────────── */
QLineEdit {
    background-color: #F8FCE0;
    border: 1px solid #9DC08B;
    border-radius: 5px;
    padding: 6px 10px;
    color: #40513B;
    min-height: 28px;
}
QLineEdit:focus {
    border: 1.5px solid #609966;
}
QLineEdit:disabled {
    background-color: #EDF1D6;
    border: 1px solid #C8D8B0;
    color: #9DC08B;
}

/* ── Поля дат — как SpinBox ─────────────────────────────── */
QDateEdit {
    background-color: #F8FCE0;
    border: 1px solid #9DC08B;
    border-radius: 5px;
    padding: 6px 28px 6px 10px;
    color: #40513B;
    min-height: 28px;
}
QDateEdit:focus {
    border: 1.5px solid #609966;
}
QDateEdit:disabled {
    background-color: #EDF1D6;
    border: 1px solid #C8D8B0;
    color: #9DC08B;
}
QDateEdit::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 28px;
    border-left: 1px solid #9DC08B;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #609966;
}
QDateEdit::drop-down:hover {
    background-color: #6DA65B;
}
QDateEdit::drop-down:disabled {
    background-color: #C8D8B0;
}
QDateEdit::down-arrow {
    image: url(:/resources/images/down_arrow.svg);
    width: 10px;
    height: 6px;
}

/* ── Выпадающий список ──────────────────────────────────── */
QComboBox {
    background-color: #F8FCE0;
    border: 1px solid #9DC08B;
    border-radius: 5px;
    padding: 6px 28px 6px 10px;
    color: #40513B;
    min-height: 28px;
}
QComboBox:focus {
    border: 1.5px solid #609966;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    width: 28px;
    border-left: 1px solid #9DC08B;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #609966;
}
QComboBox::drop-down:hover {
    background-color: #6DA65B;
}
QComboBox::down-arrow {
    image: url(:/resources/images/down_arrow.svg);
    width: 10px;
    height: 6px;
}
QComboBox QAbstractItemView {
    background-color: #F8FCE0;
    border: 1px solid #9DC08B;
    selection-background-color: #609966;
    selection-color: #fcfcee;
    outline: none;
    padding: 2px;
}

/* ── Чекбоксы ───────────────────────────────────────────── */
QCheckBox {
    color: #40513B;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #9DC08B;
    border-radius: 3px;
    background-color: #F8FCE0;
}
QCheckBox::indicator:checked {
    background-color: #609966;
    border-color: #609966;
}

/* ── Основные кнопки ────────────────────────────────────── */
QPushButton {
    background-color: #609966;
    color: #fcfcee;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 13px;
    min-width: 80px;
}
QPushButton:hover   { background-color: #6DA65B; }
QPushButton:pressed { background-color: #40513B; }

QPushButton#btnCancel {
    background-color: transparent;
    color: #40513B;
    border: 1px solid #9DC08B;
}
QPushButton#btnCancel:hover   { background-color: #9DC08B; color: #fcfcee; }
QPushButton#btnCancel:pressed { background-color: #609966; color: #fcfcee; }

/* ── Кнопки пагинации (как в главном окне) ──────────────── */
QFrame#paginationBar QPushButton {
    background-color: #6DA65B;
    color: #fcfcee;
    border: none;
    border-radius: 4px;
    min-width: 28px; max-width: 28px;
    min-height: 26px; max-height: 26px;
    font-size: 14px;
    font-weight: bold;
    padding: 0;
}
QFrame#paginationBar QPushButton:hover    { background-color: #40513B; }
QFrame#paginationBar QPushButton:disabled { background-color: #C8D8B0; color: #9DC08B; }

QFrame#paginationBar QLabel {
    color: #40513B;
    font-size: 12px;
    padding: 0 4px;
    background-color: transparent;
}

/* SpinBox в paginationBar — со стрелками */
QFrame#paginationBar QSpinBox {
    background-color: #F8FCE0;
    border: 1px solid #609966;
    border-radius: 4px;
    padding: 2px 4px;
    color: #40513B;
    min-height: 24px; max-height: 24px;
    font-size: 12px;
}
QFrame#paginationBar QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    background: #609966;
    border-top-right-radius: 4px;
}
QFrame#paginationBar QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    background: #609966;
    border-bottom-right-radius: 4px;
}
QFrame#paginationBar QSpinBox::up-button:hover,
QFrame#paginationBar QSpinBox::down-button:hover {
    background: #6DA65B;
}
QFrame#paginationBar QSpinBox::up-arrow {
    image: url(:/resources/images/up_arrow.svg);
    width: 8px;
    height: 5px;
}
QFrame#paginationBar QSpinBox::down-arrow {
    image: url(:/resources/images/down_arrow.svg);
    width: 8px;
    height: 5px;
}

/* ── Таблица результатов ────────────────────────────────── */
QTableView#resultsTable {
    background-color: #F8FCE0;
    alternate-background-color: #F5F8EC;
    gridline-color: #C8D8B0;
    border: 1px solid #9DC08B;
    border-radius: 4px;
    selection-background-color: #9DC08B;
    selection-color: #40513B;
}
QTableView#resultsTable::item {
    padding: 5px 8px;
    border-bottom: 1px solid #E0EAC8;
}
QHeaderView::section {
    background-color: #40513B;
    color: #fcfcee;
    padding: 6px 8px;
    border: none;
    font-weight: bold;
    font-size: 12px;
}

/* ── SpinBox ────────────────────────────────────────────── */
QSpinBox {
    background-color: #F8FCE0;
    border: 1px solid #9DC08B;
    border-radius: 4px;
    padding: 3px 6px;
    color: #40513B;
}


QMessageBox {
    background-color: #2b2b2b;  /* фон как у приложения */
}

    QMessageBox QLabel {
        color: #ffffff;
        font-size: 13px;
    }

    QMessageBox QPushButton {
        background-color: #3c3f41;
        color: #ffffff;
        border: 1px solid #555;
        padding: 4px 16px;
        border-radius: 4px;
    }

    QMessageBox QPushButton:hover {
        background-color: #4c5052;
    }</string>
